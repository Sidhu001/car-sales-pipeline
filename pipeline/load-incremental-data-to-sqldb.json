						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM source_cars_data WHERE Date_id > '@{activity('last_load').output.firstRow.last_load}' AND Date_id <= '@{activity('current_load').output.firstRow.max_date}'",
