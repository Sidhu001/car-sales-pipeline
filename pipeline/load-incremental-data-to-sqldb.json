					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[UpdateWatermarkTable]",
					"storedProcedureParameters": {
						"value": "@activity('current_load').output.firstRow.max_date",
						"type": "Expression"
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_sqlDb",
					"type": "LinkedServiceReference"
				}
